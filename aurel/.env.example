# ===== AUREL サイト 環境変数 =====
# コピーして .env.local を作成し、値を設定してください（.env.local は Git に含めません）

# 公開URL（sitemap.xml / OGP / canonical に使用）。末尾スラッシュなし
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- お問い合わせフォーム（Resend） ---
# 3つすべて設定されると送信が有効になります。未設定の間、フォームは「送信先未設定」と表示し、送信成功を装いません。
# https://resend.com で取得した API キー
RESEND_API_KEY=
# 問い合わせを受け取るメールアドレス（カンマ区切りで複数可）
CONTACT_TO_EMAIL=
# 送信元アドレス。Resend で認証済みのドメインのアドレスを指定（例: AUREL <noreply@example.com>）
CONTACT_FROM_EMAIL=
# 問い合わせ者へ自動返信メールを送る場合は true
CONTACT_AUTO_REPLY=false
